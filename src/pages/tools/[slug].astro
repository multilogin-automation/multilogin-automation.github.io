---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import {
  tools,
  toolSlug,
  getToolsByCategory,
  categoryColors,
  toolUseCases,
} from "../../lib/catalog";
import {
  toolTitle,
  toolDescription,
  toolJsonLd,
  canonicalUrl,
} from "../../lib/seo";
import { TELEGRAM_URL, TELEGRAM_LABEL } from "../../lib/constants";
import { sanitizeDisplay } from "../../lib/display";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: toolSlug(tool) },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const slug = toolSlug(tool);
const categoryLabel = sanitizeDisplay(tool.category_label);
const catalogDescription = sanitizeDisplay(tool.description);
const useCases = toolUseCases(tool);
const related = getToolsByCategory(tool.category)
  .filter((t) => t.id !== tool.id)
  .slice(0, 3);
---

<Layout
  title={toolTitle(tool)}
  description={toolDescription(tool)}
  canonical={canonicalUrl(`/tools/${slug}`)}
  jsonLd={toolJsonLd(tool, slug)}
>
  <main>
    <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <nav class="mb-6 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="transition hover:text-white">Tools</a>
        <span class="mx-2">/</span>
        <a href={`/category/${tool.category}`} class="transition hover:text-white">
          {categoryLabel}
        </a>
        <span class="mx-2">/</span>
        <span class="text-gray-400">#{tool.number}</span>
      </nav>

      <a
        href={`/category/${tool.category}`}
        class={`mb-4 inline-flex rounded-full border px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide transition hover:opacity-80 ${categoryColors[tool.category]}`}
      >
        {categoryLabel}
      </a>

      <h1 class="text-3xl font-bold text-white sm:text-4xl">
        {tool.name} — Multilogin X Tool #{tool.number}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-gray-300">{catalogDescription}</p>

      <div class="mt-6 space-y-3">
        {
          useCases.map((sentence) => (
            <p class="text-sm leading-relaxed text-gray-400">{sentence}</p>
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={tool.github_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-hover"
        >
          View Source on GitHub
        </a>
        <a
          href="/tools"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-raised px-5 py-2.5 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-surface-overlay"
        >
          Back to Catalog
        </a>
      </div>

      <dl class="mt-10 rounded-xl border border-border bg-surface-raised p-5 text-sm">
        <div class="flex justify-between gap-4 border-b border-border py-2">
          <dt class="text-gray-500">Script file</dt>
          <dd class="font-mono text-gray-300">{tool.script}</dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-border py-2">
          <dt class="text-gray-500">Category</dt>
          <dd>
            <a href={`/category/${tool.category}`} class="text-blue-400 hover:text-blue-300">
              {categoryLabel}
            </a>
          </dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-gray-500">{TELEGRAM_LABEL}</dt>
          <dd>
            <a
              href={TELEGRAM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-400 hover:text-blue-300"
            >
              Get scripts on Telegram
            </a>
          </dd>
        </div>
      </dl>
    </article>

    {
      related.length > 0 && (
        <section class="border-t border-border bg-surface-raised/30">
          <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
            <h2 class="text-xl font-bold text-white">Related Tools</h2>
            <p class="mt-1 text-sm text-gray-500">More {categoryLabel} demos</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-3">
              {related.map((t) => (
                <li>
                  <a
                    href={`/tools/${toolSlug(t)}`}
                    class="block rounded-lg border border-border bg-surface-raised p-4 transition hover:border-accent/50"
                  >
                    <span class="font-mono text-xs text-gray-500">#{t.number}</span>
                    <span class="mt-1 block font-medium text-white">{t.name}</span>
                    <span class="mt-1 block text-sm text-gray-500 line-clamp-1">
                      {sanitizeDisplay(t.description)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <Footer />
  </main>
</Layout>
