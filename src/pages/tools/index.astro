---
import Layout from "../../layouts/Layout.astro";
import ToolCatalog from "../../components/ToolCatalog.astro";
import Footer from "../../components/Footer.astro";
import { tools } from "../../lib/catalog";
import {
  toolsPageTitle,
  toolsPageDescription,
  canonicalUrl,
  catalogItemListJsonLd,
} from "../../lib/seo";
---

<Layout
  title={toolsPageTitle(tools.length)}
  description={toolsPageDescription(tools.length)}
  canonical={canonicalUrl("/tools")}
  jsonLd={catalogItemListJsonLd("Multilogin X Tool Catalog — All Demos", tools)}
>
  <main>
    <div class="border-b border-border bg-surface-raised/30">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <h1 class="text-3xl font-bold text-white sm:text-4xl">Tool Catalog</h1>
        <p class="mt-3 max-w-2xl text-gray-400">
          Complete index of {tools.length} open-source Playwright CDP automation demos
          for Multilogin X antidetect browser profiles.
        </p>
      </div>
    </div>
    <ToolCatalog tools={tools} showHeading={false} />
    <Footer />
  </main>
</Layout>
