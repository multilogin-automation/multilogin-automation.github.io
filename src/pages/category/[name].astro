---
import Layout from "../../layouts/Layout.astro";
import CategoryToolGrid from "../../components/CategoryToolGrid.astro";
import Footer from "../../components/Footer.astro";
import {
  getCategories,
  getToolsByCategory,
  categoryIntros,
} from "../../lib/catalog";
import { categoryIntroFooter } from "../../lib/category-content";
import {
  categoryTitle,
  categoryDescription,
  categoryJsonLd,
  canonicalUrl,
} from "../../lib/seo";

export function getStaticPaths() {
  return getCategories().map((cat) => ({
    params: { name: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const catTools = getToolsByCategory(category.slug);
const introParagraphs = [
  ...(categoryIntros[category.slug] ?? []),
  categoryIntroFooter,
];
const h1 = `${category.label} Automation Tools`;
---

<Layout
  title={categoryTitle(category.label)}
  description={categoryDescription(category.label, category.count, category.slug)}
  canonical={canonicalUrl(`/category/${category.slug}`)}
  jsonLd={categoryJsonLd(category.label, category.slug, catTools)}
>
  <main>
    <div class="border-b border-border bg-surface-raised/30">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <nav class="mb-4 text-sm text-gray-500" aria-label="Breadcrumb">
          <a href="/" class="transition hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/tools" class="transition hover:text-white">Tools</a>
          <span class="mx-2">/</span>
          <span class="text-gray-400">{category.label}</span>
        </nav>

        <h1 class="text-3xl font-bold text-white sm:text-4xl">{h1}</h1>
        <p class="mt-2 text-sm text-gray-500">
          {category.count} open-source Playwright CDP tools
        </p>

        <div class="prose prose-invert mt-6 max-w-3xl">
          {
            introParagraphs.map((p) => (
              <p class="mb-4 text-sm leading-relaxed text-gray-400">{p}</p>
            ))
          }
        </div>

        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <a href="/" class="text-blue-400 transition hover:text-blue-300">Homepage</a>
          <span class="text-gray-600">·</span>
          <a href="/tools" class="text-blue-400 transition hover:text-blue-300">All Tools</a>
          <span class="text-gray-600">·</span>
          <span class="text-gray-500">{category.count} tools below</span>
        </div>
      </div>
    </div>

    <CategoryToolGrid tools={catTools} categorySlug={category.slug} />
    <Footer />
  </main>
</Layout>
