---
import FaqList from "./FaqList.astro";
---

<section id="faq" class="border-t border-border bg-surface-raised/30">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Frequently Asked Questions</h2>
        <p class="mt-2 text-gray-400">
          Common questions about the Multilogin X Automation SDK catalog.
        </p>
      </div>
      <a href="/faq" class="text-sm font-medium text-blue-400 transition hover:text-blue-300">
        View all FAQ &rarr;
      </a>
    </div>

    <div class="mt-8">
      <FaqList showTitle={false} limit={3} />
    </div>
  </div>
</section>
