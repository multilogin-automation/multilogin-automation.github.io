---
import { getCategories } from "../lib/catalog";
import {
  SDK_URL,
  TELEGRAM_URL,
  TELEGRAM_LABEL,
  AFFILIATE_URL,
  LEGAL_DISCLAIMER,
  CATALOG_SOURCE_URL,
} from "../lib/constants";

const categories = getCategories();
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-raised">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="text-sm font-semibold text-white">Multilogin X Automation SDK</h3>
        <p class="mt-2 text-sm text-gray-500">
          Official catalog and landing for open-source Playwright CDP automation tools.
        </p>
        <p class="mt-3 text-xs text-gray-600">
          Data synced from{" "}
          <a
            href={CATALOG_SOURCE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 underline hover:text-gray-400"
          >
            GitHub catalog.json
          </a>
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Resources</h3>
        <ul class="mt-2 space-y-2 text-sm">
          <li>
            <a href="/tools" class="text-gray-400 transition hover:text-white">Tool Catalog</a>
          </li>
          <li>
            <a href="/docs/quick-start" class="text-gray-400 transition hover:text-white">Quick Start</a>
          </li>
          <li>
            <a href="/faq" class="text-gray-400 transition hover:text-white">FAQ</a>
          </li>
          <li>
            <a href={SDK_URL} target="_blank" rel="noopener noreferrer" class="text-gray-400 transition hover:text-white">
              GitHub Repository
            </a>
          </li>
          <li>
            <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="text-gray-400 transition hover:text-white">
              {TELEGRAM_LABEL}
            </a>
          </li>
          <li>
            <a href={AFFILIATE_URL} target="_blank" rel="noopener noreferrer" class="text-gray-400 transition hover:text-white">
              Multilogin (SAAS50)
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Categories</h3>
        <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
          {
            categories.slice(0, 8).map((cat) => (
              <li>
                <a href={`/category/${cat.slug}`} class="text-gray-400 transition hover:text-white">
                  {cat.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Legal</h3>
        <p class="mt-2 text-sm text-gray-500">
          {LEGAL_DISCLAIMER} Users are responsible for compliance with applicable laws and platform terms of service.
        </p>
      </div>
    </div>

    <div class="mt-8 border-t border-border pt-8 text-center text-xs text-gray-600">
      &copy; {year} multilogin-automation. All demos are MIT licensed.
    </div>
  </div>
</footer>
