---
import { faqs } from "../lib/faq-data";

interface Props {
  showTitle?: boolean;
  limit?: number;
}

const { showTitle = true, limit } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

{
  showTitle && (
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white sm:text-4xl">Frequently Asked Questions</h1>
      <p class="mt-3 text-gray-400">
        Answers about Multilogin X, Playwright CDP, legal use, and the 120-tool automation catalog.
      </p>
    </div>
  )
}

<dl class="space-y-6">
  {
    items.map((faq) => (
      <div class="rounded-xl border border-border bg-surface-raised p-5">
        <dt class="text-base font-semibold text-white">{faq.q}</dt>
        <dd class="mt-2 text-sm leading-relaxed text-gray-400">{faq.a}</dd>
      </div>
    ))
  }
</dl>
