---
import { getCategories } from "../lib/catalog";
import { SDK_URL, TELEGRAM_URL, TELEGRAM_LABEL, SITE_NAME } from "../lib/constants";

const categories = getCategories();
const currentPath = Astro.url.pathname;

const navLink = (active: boolean) =>
  active
    ? "shrink-0 rounded-md px-2 py-1.5 text-xs font-medium bg-accent/20 text-blue-200 sm:px-2.5 sm:text-sm"
    : "shrink-0 rounded-md px-2 py-1.5 text-xs font-medium text-gray-400 transition hover:text-white sm:px-2.5 sm:text-sm";
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/95 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-3 py-2.5 sm:px-6 sm:py-3">
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="flex shrink-0 items-center gap-1.5 text-sm font-semibold text-white transition hover:text-blue-300"
        aria-label={SITE_NAME}
      >
        <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="#161b22"/>
          <path d="M8 22V10h4.5c2.2 0 3.5 1.2 3.5 3s-1.3 3-3.5 3H11v6H8zm3-9v3h1.4c.9 0 1.4-.5 1.4-1.5S13.3 13 12.4 13H11z" fill="#3b82f6"/>
          <path d="M17 22l5-12h3.5l5 12h-3.2l-1-2.8h-4.8L20 22H17zm4.2-5.2h3.2l-1.6-4.4-1.6 4.4z" fill="#60a5fa"/>
        </svg>
        <span class="hidden min-[375px]:inline max-w-[7rem] truncate sm:max-w-none">{SITE_NAME}</span>
      </a>

      <nav
        class="flex flex-1 items-center justify-end gap-0.5 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] sm:gap-1 [&::-webkit-scrollbar]:hidden"
        aria-label="Main navigation"
      >
        <a href="/tools" class={navLink(currentPath.startsWith("/tools"))}>Tools</a>

        <div class="relative shrink-0" id="categories-menu">
          <button
            type="button"
            id="categories-toggle"
            class:list={[
              navLink(currentPath.startsWith("/category")),
              "flex items-center gap-0.5",
            ]}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="categories-dropdown"
          >
            Categories
            <svg class="h-3 w-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div
            id="categories-dropdown"
            class="invisible absolute right-0 top-full z-50 hidden pt-1 opacity-0 transition md:group-hover:visible md:group-hover:block md:group-hover:opacity-100"
          >
            <div class="max-h-64 w-56 overflow-y-auto rounded-lg border border-border bg-surface-raised py-2 shadow-xl">
              {
                categories.map((cat) => (
                  <a
                    href={`/category/${cat.slug}`}
                    class="block px-4 py-1.5 text-sm text-gray-400 transition hover:bg-surface-overlay hover:text-white"
                  >
                    {cat.label}
                    <span class="ml-1 text-gray-600">({cat.count})</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <a href="/docs/quick-start" class={navLink(currentPath.startsWith("/docs"))}>Docs</a>
        <a href="/faq" class={navLink(currentPath.startsWith("/faq"))}>FAQ</a>
        <a
          href={SDK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={navLink(false)}
        >
          GitHub
        </a>
        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={navLink(false)}
        >
          {TELEGRAM_LABEL}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const menu = document.getElementById("categories-menu");
  const toggle = document.getElementById("categories-toggle");
  const dropdown = document.getElementById("categories-dropdown");

  if (menu && toggle && dropdown) {
    const show = () => {
      dropdown.classList.remove("hidden", "invisible", "opacity-0");
      dropdown.classList.add("block", "opacity-100");
      toggle.setAttribute("aria-expanded", "true");
    };
    const hide = () => {
      dropdown.classList.add("hidden", "invisible", "opacity-0");
      dropdown.classList.remove("block", "opacity-100");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = toggle.getAttribute("aria-expanded") === "true";
      open ? hide() : show();
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target)) hide();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hide();
    });
  }
</script>
