---
import { SDK_URL } from "../lib/constants";

interface Props {
  toolCount: number;
  categoryCount: number;
}

const { toolCount, categoryCount } = Astro.props;
const statsBar = `${toolCount} Tools · ${categoryCount} Categories · Open Source · Playwright CDP`;
---

<section class="relative overflow-hidden border-b border-border">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(59,130,246,0.15),_transparent_60%)]"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <p class="mb-4 text-sm font-medium uppercase tracking-wider text-blue-400">
      Official Catalog &amp; Landing
    </p>

    <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      Multilogin X Automation SDK — {toolCount} Antidetect Browser Tools
    </h1>

    <p class="mt-4 max-w-2xl text-lg text-gray-400 sm:text-xl">
      Open-source Playwright CDP demos for profile management, browser warmup,
      session QA, and antidetect browser research.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/tools"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-hover"
      >
        Browse Tools
      </a>
      <a
        href={SDK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-raised px-5 py-2.5 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-surface-overlay"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"></path>
        </svg>
        View on GitHub
      </a>
    </div>

    <p class="mt-10 rounded-xl border border-border bg-surface-raised/50 px-5 py-3 text-sm text-gray-400">
      {statsBar}
    </p>
  </div>
</section>
