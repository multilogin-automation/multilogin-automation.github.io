---
import type { Tool } from "../types";
import { toolSlug, categoryColors } from "../lib/catalog";
import { sanitizeDisplay } from "../lib/display";

interface Props {
  tools: Tool[];
  heading?: string;
  subheading?: string;
  showHeading?: boolean;
  id?: string;
}

const {
  tools,
  heading = "Tool Catalog",
  subheading = "Filter by category or search by name. Each tool links to its detail page and GitHub source.",
  showHeading = true,
  id = "tools",
} = Astro.props;

const categories = [...new Set(tools.map((t) => t.category))].sort();
const categoryLabels = Object.fromEntries(
  tools.map((t) => [t.category, sanitizeDisplay(t.category_label)])
);

const categoryCounts = categories.reduce(
  (acc, cat) => {
    acc[cat] = tools.filter((t) => t.category === cat).length;
    return acc;
  },
  {} as Record<string, number>
);
---

<section id={id} class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  {
    showHeading && (
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">{heading}</h2>
        <p class="mt-2 text-gray-400">{subheading}</p>
      </div>
    )
  }

  <div class="sticky top-[52px] z-10 -mx-4 border-b border-border bg-surface/95 px-4 py-4 backdrop-blur-sm sm:top-14 sm:-mx-6 sm:px-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="relative flex-1 lg:max-w-sm">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          id="tool-search"
          type="search"
          placeholder="Search tools..."
          autocomplete="off"
          class="w-full rounded-lg border border-border bg-surface-raised py-2.5 pl-10 pr-4 text-sm text-gray-100 placeholder-gray-500 outline-none transition focus:border-accent focus:ring-1 focus:ring-accent"
        />
      </div>
      <p id="result-count" class="text-sm text-gray-500">
        Showing <span class="font-medium text-gray-300">{tools.length}</span> of {tools.length} tools
      </p>
    </div>

    <div
      id="category-filters"
      class="mt-4 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter by category"
    >
      <button
        type="button"
        data-category="all"
        class="category-btn active rounded-full border border-accent bg-accent/20 px-3 py-1 text-xs font-medium text-blue-200 transition"
      >
        All ({tools.length})
      </button>
      {
        categories.map((cat) => (
          <button
            type="button"
            data-category={cat}
            class={`category-btn rounded-full border px-3 py-1 text-xs font-medium transition ${categoryColors[cat] ?? "bg-gray-500/15 text-gray-300 border-gray-500/30"}`}
          >
            {categoryLabels[cat]} ({categoryCounts[cat]})
          </button>
        ))
      }
    </div>
  </div>

  <div id="tool-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      tools.map((tool) => {
        const slug = toolSlug(tool);
        const label = categoryLabels[tool.category] ?? tool.category;
        return (
          <article
            data-category={tool.category}
            data-name={tool.name.toLowerCase()}
            data-description={sanitizeDisplay(tool.description).toLowerCase()}
            class="tool-card group flex flex-col rounded-xl border border-border bg-surface-raised p-5 transition hover:border-accent/50 hover:bg-surface-overlay"
          >
            <div class="mb-3 flex items-start justify-between gap-2">
              <span class="rounded-md bg-surface-overlay px-2 py-0.5 font-mono text-xs font-medium text-gray-400">
                #{tool.number}
              </span>
              <a
                href={`/category/${tool.category}`}
                class={`shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide transition hover:opacity-80 ${categoryColors[tool.category] ?? "bg-gray-500/15 text-gray-300 border-gray-500/30"}`}
              >
                {label}
              </a>
            </div>
            <h3 class="text-base font-semibold text-white">
              <a href={`/tools/${slug}`} class="transition hover:text-blue-300">
                {tool.name}
              </a>
            </h3>
            <p class="mt-2 flex-1 text-sm text-gray-400 line-clamp-2">
              {sanitizeDisplay(tool.description)}
            </p>
            <div class="mt-4 flex items-center justify-between gap-2 border-t border-border pt-3">
              <span class="truncate font-mono text-xs text-gray-600">{tool.script}</span>
              <a
                href={tool.github_url}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 text-xs font-medium text-blue-400 transition hover:text-blue-300"
              >
                View source &rarr;
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  <p id="no-results" class="mt-8 hidden text-center text-gray-500">
    No tools match your search. Try a different keyword or category.
  </p>
</section>

<script define:vars={{ totalTools: tools.length }}>
  const searchInput = document.getElementById("tool-search");
  const categoryBtns = document.querySelectorAll(".category-btn");
  const toolCards = document.querySelectorAll(".tool-card");
  const resultCount = document.getElementById("result-count");
  const noResults = document.getElementById("no-results");

  let activeCategory = "all";
  let debounceTimer;

  function updateFilter() {
    const query = searchInput.value.trim().toLowerCase();
    let visible = 0;

    toolCards.forEach((card) => {
      const cat = card.dataset.category;
      const name = card.dataset.name;
      const desc = card.dataset.description;

      const matchesCategory = activeCategory === "all" || cat === activeCategory;
      const matchesSearch = !query || name.includes(query) || desc.includes(query);

      const show = matchesCategory && matchesSearch;
      card.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    resultCount.innerHTML = `Showing <span class="font-medium text-gray-300">${visible}</span> of ${totalTools} tools`;
    noResults.classList.toggle("hidden", visible > 0);
  }

  searchInput.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updateFilter, 200);
  });

  categoryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.category;
      categoryBtns.forEach((b) => {
        b.classList.remove("active", "border-accent", "bg-accent/20", "text-blue-200");
      });
      btn.classList.add("active", "border-accent", "bg-accent/20", "text-blue-200");
      updateFilter();
    });
  });
</script>
